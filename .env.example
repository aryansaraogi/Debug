# Copy to .env and fill in. The real .env is gitignored — never commit it.

# Anthropic API key. Note: this project reads ANTHROPIC_KEY, not the SDK's
# default ANTHROPIC_API_KEY, so the client is constructed with it explicitly.
ANTHROPIC_KEY=sk-ant-...

# Optional overrides
# DEVOPS_MCP_MODEL=claude-opus-5
# DEVOPS_MCP_ROOTS=/path/to/project/you/want/to/investigate
# DEVOPS_MCP_ALLOW_ACTIONS=1
# DEVOPS_MCP_ACTION_CONTAINERS=broken-backend,broken_app-*
